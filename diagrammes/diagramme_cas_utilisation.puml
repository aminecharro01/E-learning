@startuml

title Diagramme de cas d'utilisation - IAT Academy

left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam dpi 300
skinparam linetype ortho

skinparam usecase {
    BackgroundColor #F1F1F1
    BorderColor black
    FontColor black
    FontSize 11
}

skinparam actor {
    FontColor black
    BorderColor black
}

skinparam rectangle {
    BackgroundColor white
    BorderColor black
    FontColor black
}


' =========================================================
' ACTEURS
' =========================================================

actor "Visiteur" as Visiteur

actor "Utilisateur\nConnecté" as User
actor "Étudiant" as Etudiant

actor "Formateur" as Formateur
actor "Admin\n(Directeur)" as Admin
actor "Super Admin" as SuperAdmin


' =========================================================
' HÉRITAGE DES ACTEURS
' =========================================================

Etudiant --|> User #line:orange
Formateur --|> User #line:orange
Admin --|> Formateur #line:orange
SuperAdmin --|> Admin #line:orange


' =========================================================
' SYSTÈME
' =========================================================

rectangle "Système IAT Academy" {

    ' -----------------------------------------------------
    ' ACCÈS ET COMPTE
    ' -----------------------------------------------------

    usecase "S'inscrire" as UC_Register #line:blue

    usecase "S'authentifier\n(2FA)" as UC_Login #line:blue

    usecase "Accéder à son\nespace personnel" as UC_AccessSpace #line:green

    usecase "Gérer son profil" as UC_Profile #line:green

    usecase "Contacter\nl'académie" as UC_Contact #line:blue

    usecase "Vérifier un\ncertificat" as UC_VerifyCertificate #line:blue


    ' -----------------------------------------------------
    ' COURS ET ÉVALUATIONS
    ' -----------------------------------------------------

    usecase "Consulter les\ncours et modules" as UC_ViewLesson

    usecase "Passer une\névaluation" as UC_TakeQuiz

    usecase "Consulter ses\nrésultats" as UC_ViewResults

    usecase "Concevoir un\nquiz" as UC_ManageQuiz #line:purple

    usecase "Générer des\nquestions par IA" as UC_AiGenerate

    usecase "Évaluer et\nnoter les copies" as UC_Grade #line:purple


    ' -----------------------------------------------------
    ' STAGE ET CERTIFICATION
    ' -----------------------------------------------------

    usecase "Soumettre son\ndossier de stage" as UC_StageDossier

    usecase "Valider une unité\nde formation (UF)" as UC_ValidateUf #line:red

    usecase "Consulter son\ncertificat" as UC_Certificate

    usecase "Inviter le tuteur\nà signer" as UC_InviteSignoff #line:red


    ' -----------------------------------------------------
    ' ADMINISTRATION ET SERVICES
    ' -----------------------------------------------------

    usecase "Échanger par\nmessagerie interne" as UC_Message #line:green

    usecase "Gérer les utilisateurs\net droits" as UC_ManageUsers #line:red

    usecase "Gérer les cohortes\net classes" as UC_ManageGroups #line:red

    usecase "Consulter les\njournaux d'audit" as UC_AuditLog #line:red

    usecase "Configurer les\nparamètres généraux" as UC_AppSettings #line:red

    usecase "Consulter la\nbourse à l'emploi" as UC_JobsView #line:purple


    ' =====================================================
    ' ORGANISATION INTERNE DES USE CASES
    ' =====================================================

    ' ----- Colonne 1 -----

    UC_Register -[hidden]down-> UC_Login
    UC_Login -[hidden]down-> UC_Contact
    UC_Contact -[hidden]down-> UC_VerifyCertificate


    ' ----- Colonne 2 -----

    UC_AccessSpace -[hidden]down-> UC_Profile
    UC_Profile -[hidden]down-> UC_Message
    UC_Message -[hidden]down-> UC_JobsView


    ' ----- Colonne 3 -----

    UC_ViewLesson -[hidden]down-> UC_TakeQuiz
    UC_TakeQuiz -[hidden]down-> UC_ViewResults


    ' ----- Colonne 4 -----

    UC_ManageQuiz -[hidden]down-> UC_AiGenerate
    UC_AiGenerate -[hidden]down-> UC_Grade


    ' ----- Colonne 5 -----

    UC_StageDossier -[hidden]down-> UC_ValidateUf
    UC_ValidateUf -[hidden]down-> UC_InviteSignoff
    UC_InviteSignoff -[hidden]down-> UC_Certificate


    ' ----- Administration -----

    UC_ManageUsers -[hidden]down-> UC_ManageGroups
    UC_ManageGroups -[hidden]down-> UC_AuditLog
    UC_AuditLog -[hidden]down-> UC_AppSettings


    ' ----- Espacement horizontal -----

    UC_Register -[hidden]right-> UC_AccessSpace
    UC_AccessSpace -[hidden]right-> UC_ViewLesson
    UC_ViewLesson -[hidden]right-> UC_ManageQuiz
    UC_ManageQuiz -[hidden]right-> UC_StageDossier
    UC_StageDossier -[hidden]right-> UC_ManageUsers

}


' =========================================================
' RELATIONS AVEC LES ACTEURS
' =========================================================


' -------------------------
' VISITEUR
' -------------------------

Visiteur --> UC_Register #line:blue
Visiteur --> UC_Login #line:blue
Visiteur --> UC_Contact #line:blue
Visiteur --> UC_VerifyCertificate #line:blue


' -------------------------
' UTILISATEUR CONNECTÉ
' -------------------------

User --> UC_AccessSpace #line:green
User --> UC_Profile #line:green
User --> UC_Message #line:green


' -------------------------
' ÉTUDIANT
' -------------------------

Etudiant --> UC_ViewLesson
Etudiant --> UC_TakeQuiz
Etudiant --> UC_ViewResults
Etudiant --> UC_StageDossier
Etudiant --> UC_Certificate
Etudiant --> UC_JobsView


' -------------------------
' FORMATEUR
' -------------------------

Formateur --> UC_ManageQuiz #line:purple
Formateur --> UC_Grade #line:purple


' -------------------------
' ADMIN
' -------------------------

Admin --> UC_ValidateUf #line:red
Admin --> UC_InviteSignoff #line:red
Admin --> UC_ManageUsers #line:red
Admin --> UC_ManageGroups #line:red
Admin --> UC_AuditLog #line:red


' -------------------------
' SUPER ADMIN
' -------------------------

SuperAdmin --> UC_AppSettings #line:red


' =========================================================
' RELATIONS ENTRE CAS
' =========================================================

UC_AccessSpace .> UC_Login : <<include>>

UC_AiGenerate .> UC_ManageQuiz : <<extend>>

UC_InviteSignoff .> UC_ValidateUf : <<extend>>


' =========================================================
' POSITIONNEMENT DES ACTEURS
' =========================================================

' Acteurs de gauche

Visiteur -[hidden]right-> UC_Register

User -[hidden]right-> UC_AccessSpace

Etudiant -[hidden]right-> UC_ViewLesson


' Acteurs de droite

UC_ManageQuiz -[hidden]right-> Formateur

UC_ValidateUf -[hidden]right-> Admin

UC_AppSettings -[hidden]right-> SuperAdmin


' Héritage vertical

User -[hidden]down-> Etudiant

Formateur -[hidden]down-> Admin

Admin -[hidden]down-> SuperAdmin

@enduml