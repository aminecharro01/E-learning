@startuml diagramme_sequence_certificat_verification_linkedin
!theme plain
skinparam dpi 300
title Séquence — Vérification publique de certificat et partage LinkedIn

actor "Tiers (recruteur)" as Tiers
participant "LinkedIn\n(crawler)" as LinkedIn
participant "Page Next.js\n/verify/[code]\n(server component)" as Page
participant "CertificateController" as Ctrl
participant "CertificateService" as CertSvc
database "PostgreSQL" as DB

Tiers -> Page : GET /verify/{code}
Page -> Page : generateMetadata({code})
Page -> Ctrl : GET /api/certificates/verify/{code}\n(public, sans authentification)
Ctrl -> CertSvc : verify(code)
CertSvc -> DB : findByVerificationCode(code)

alt code invalide
  DB --> CertSvc : introuvable
  CertSvc --> Ctrl : NotFoundException
  Ctrl --> Page : 404
  Page --> Tiers : page "code invalide"
else code valide
  DB --> CertSvc : Certificate
  CertSvc --> Ctrl : CertificateResponse\n(nom apprenant, formation, date —\naucune donnée sensible : pas d'email,\npas d'ID utilisateur, pas de PDF)
  Ctrl --> Page : 200 OK
  Page -> Page : rendu SSR + balises\nOpen Graph (og:title, og:description)
  Page --> Tiers : HTML avec métadonnées OG déjà présentes

  Tiers -> LinkedIn : clique "Partager sur LinkedIn"
  LinkedIn -> Page : GET /verify/{code}\n(le crawler LinkedIn, sans exécuter de JS)
  Page --> LinkedIn : HTML statique avec OG tags\n(déjà rendues côté serveur)
  LinkedIn --> Tiers : boîte de partage pré-remplie
end

@enduml
