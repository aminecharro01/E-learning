@startuml diagramme_classes_stage_certification
!theme plain
skinparam dpi 300
skinparam classAttributeIconSize 0
hide circle
hide empty members

title Diagramme de classes — Stage et certification

abstract class AuditableEntity {
  - id : UUID
  # createdAt : Instant
  # updatedAt : Instant
}

class User {
  - email : String
  - fullName : String
  - role : Role
}

class Formation {
  - title : String
}

class LearnerUfValidation {
  - ufCode : String
  - validated : boolean
  - validatedAt : Instant
  - note : String
}

class StageSignoffInvite {
  - token : String
  - tutorEmail : String
  - tutorName : String
  - expiresAt : Instant
  - usedAt : Instant
}

class LearnerDocument {
  - docType : LearnerDocType
  - status : LearnerDocStatus
  - notes : String
}

class Asset {
  - filename : String
  - assetKind : String
  - extractedText : String
}

class Certificate {
  - verificationCode : String
  - issuedAt : Instant
  - pdfPath : String
  - physicallyDelivered : boolean
}

enum LearnerDocType {
  CONVENTION_ECOLE
  ASSURANCE
  CONVENTION_ENTREPRISE
  RAPPORT_STAGE
  PRESENTATION_SOUTENANCE
}

enum LearnerDocStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
}

AuditableEntity <|-- LearnerUfValidation
AuditableEntity <|-- StageSignoffInvite
AuditableEntity <|-- LearnerDocument
AuditableEntity <|-- Certificate

LearnerDocument ..> LearnerDocType
LearnerDocument ..> LearnerDocStatus

User "1" -- "0..N" LearnerUfValidation : apprenant >
User "0..1" -- "0..N" LearnerUfValidation : validé par >
LearnerUfValidation "1" -- "0..N" StageSignoffInvite

User "1" -- "0..N" LearnerDocument : apprenant >
User "1" -- "0..N" LearnerDocument : déposé par >
Asset "1" -- "0..N" LearnerDocument

User "1" -- "0..N" Certificate
Formation "1" -- "0..N" Certificate

note bottom of LearnerUfValidation
  Gate manuel du Directeur limité à deux UF :
  "UF 5" (stage) et "UF 11" (soutenance).
  Pour toute autre UF, isValidated() renvoie
  toujours true (voir ch. 3, §3.2.3).
end note

@enduml
