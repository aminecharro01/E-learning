@startuml diagramme_classes_ensemble
!theme plain

' ============================================================
' CONFIGURATION GÉNÉRALE
' ============================================================

skinparam dpi 300
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

skinparam nodesep 40
skinparam ranksep 55

skinparam class {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
    FontColor Black
    FontStyle Normal
}

skinparam package {
    BackgroundColor #FAFAFA
    BorderColor #555555
    FontColor Black
    FontStyle bold
}

skinparam ArrowColor #444444

title Diagramme de classes — Vue d'ensemble simplifiée (IAT Academy)

' ============================================================
' CLASSE TECHNIQUE
' ============================================================

abstract class AuditableEntity {
  # createdAt : Instant
  # updatedAt : Instant
}

' ============================================================
' UTILISATEURS & GROUPES (3 classes)
' ============================================================

package "Utilisateurs & Groupes (3)" as PKG_USERS {
  class User {
    - id : UUID
    - fullName : String
    - role : Role
  }
  class LearnerGroup {
    - id : UUID
    - name : String
  }
}

' ============================================================
' CONTENU PÉDAGOGIQUE (6 classes)
' ============================================================

package "Contenu pédagogique (6)" as PKG_CONTENU {
  class Formation {
    - id : UUID
    - title : String
  }
  class ModuleEntity {
    - id : UUID
    - title : String
  }
  class Lesson {
    - id : UUID
    - title : String
  }
}

' ============================================================
' ÉVALUATION (9 classes)
' ============================================================

package "Évaluation (9)" as PKG_EVAL {
  class Quiz {
    - id : UUID
    - title : String
    - quizType : QuizType
  }
  class QuizAttempt {
    - id : UUID
    - score : BigDecimal
    - status : AttemptStatus
  }
}

' ============================================================
' STAGE & CERTIFICATION (4 classes)
' ============================================================

package "Stage & Certification (4)" as PKG_STAGE {
  class LearnerUfValidation {
    - id : UUID
    - ufCode : String
    - validated : boolean
  }
  class Certificate {
    - id : UUID
    - verificationCode : String
  }
}

' ============================================================
' COMMUNICATION (5 classes)
' ============================================================

package "Communication (5)" as PKG_COMM {
  class Conversation {
    - id : UUID
    - type : ConversationType
  }
  class Notification {
    - id : UUID
    - title : String
  }
}

' ============================================================
' MARKETING & EMPLOI (5 classes)
' ============================================================

package "Marketing & Emploi (5)" as PKG_MARKETING {
  class EmailCampaign {
    - id : UUID
    - subject : String
  }
  class JobOffer {
    - id : UUID
    - title : String
  }
}

' ============================================================
' MÉDIAS (3 classes)
' ============================================================

package "Médias (3)" as PKG_MEDIAS {
  class Asset {
    - id : UUID
    - filename : String
  }
}

' ============================================================
' SYSTÈME (4 classes)
' ============================================================

package "Système (4)" as PKG_SYSTEME {
  class AuditLogEntry {
    - id : UUID
    - action : String
  }
}

' ============================================================
' HÉRITAGE TECHNIQUE
' ============================================================

AuditableEntity <|-- User
AuditableEntity <|-- LearnerGroup
AuditableEntity <|-- Formation
AuditableEntity <|-- ModuleEntity
AuditableEntity <|-- Lesson
AuditableEntity <|-- Quiz
AuditableEntity <|-- QuizAttempt
AuditableEntity <|-- LearnerUfValidation
AuditableEntity <|-- Certificate
AuditableEntity <|-- Conversation
AuditableEntity <|-- Notification
AuditableEntity <|-- EmailCampaign
AuditableEntity <|-- JobOffer
AuditableEntity <|-- Asset
AuditableEntity <|-- AuditLogEntry

' ============================================================
' RELATIONS PRINCIPALES ENTRE PAQUETAGES
' ============================================================

User "0..N" -- "0..1" LearnerGroup

Formation "1" *-- "0..N" ModuleEntity
ModuleEntity "1" *-- "0..N" Lesson

Lesson "0..1" -- "0..N" Quiz
User "1" -- "0..N" QuizAttempt
Quiz "1" -- "0..N" QuizAttempt

User "1" -- "0..N" LearnerUfValidation
User "1" -- "0..N" Certificate
Formation "1" -- "0..N" Certificate

LearnerGroup "0..1" -- "0..N" Conversation
User "1" -- "0..N" Notification : reçoit

LearnerGroup "0..1" -- "0..N" EmailCampaign
JobOffer ..> Certificate : vérifie l'éligibilité

User "1" ..> Asset : consulte / télécharge

User "0..1" -- "0..N" AuditLogEntry

' ============================================================
' NOTES
' ============================================================

note right of AuditableEntity
  Superclasse technique (@MappedSuperclass).
  38 des 39 entités concrètes en héritent ;
  seule AssetDownload n'a pas d'audit trail.
end note

note bottom of Quiz
  Portée réelle déterminée par quizType :
  Lesson (APPLICATIF), ModuleEntity (FIN_MODULE)
  ou Formation (FIN_UF / FIN_ANNEE) — simplifiée
  ici à Lesson. Détail complet : diagramme Évaluation.
end note

note "Vue d'ensemble SIMPLIFIÉE : 15 classes représentatives sur les 39\nentités JPA concrètes (+ 1 superclasse abstraite AuditableEntity),\nune à trois par paquetage. Seules les relations et cardinalités les\nplus structurantes sont représentées. Le détail complet (toutes les\nclasses, tous les attributs, toutes les associations) est donné par\nles diagrammes de classes par domaine (Figures suivantes)." as N1

@enduml
