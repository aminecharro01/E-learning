# ========== Database ==========
DB_URL=jdbc:postgresql://localhost:5433/iat_academy
DB_USER=iat
DB_PASSWORD=iat_secret

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ========== JWT ==========
# Use a long random secret (>= 32 chars / 256 bits)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-256-bits-long!!
JWT_EXPIRATION_MS=86400000
JWT_COOKIE_NAME=iat_token
# Set true behind HTTPS in production
JWT_COOKIE_SECURE=false

# ========== App ==========
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:3000
MEDIA_ROOT=./data/media
MEDIA_SIGNED_TTL=3600
# Comma-separated IPs of reverse proxies allowed to set X-Forwarded-For.
# Leave empty unless the API sits behind a known proxy/load balancer.
TRUSTED_PROXIES=
# Set to false in production to stop serving Swagger UI / OpenAPI docs publicly.
SWAGGER_ENABLED=true

# ========== Frontend ==========
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_JWT_COOKIE_NAME=iat_token
