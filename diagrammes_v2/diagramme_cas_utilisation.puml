@startuml

title Diagramme de cas d'utilisation - IAT Academy (v2 — relations nommées)

left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam dpi 300
skinparam linetype polyline
skinparam nodesep 30
skinparam ranksep 45

skinparam usecase {
    BackgroundColor #F1F1F1
    BorderColor black
    FontColor black
    FontSize 11
}

skinparam actor {
    FontColor black
    BorderColor black
}

skinparam rectangle {
    BackgroundColor white
    BorderColor black
    FontColor black
}

skinparam note {
    BackgroundColor #FFF8EC
    BorderColor #C97612
    FontColor #23282F
    FontSize 10
}


' =========================================================
' ACTEURS
' =========================================================

actor "Visiteur" as Visiteur

actor "Utilisateur\nConnecté" as User
actor "Étudiant" as Etudiant

actor "Formateur" as Formateur
actor "Admin\n(Directeur)" as Admin
actor "Super Admin" as SuperAdmin
actor "Support" as Support


' =========================================================
' HÉRITAGE DES ACTEURS
' =========================================================

Etudiant --|> User #line:orange
Formateur --|> User #line:orange
Admin --|> Formateur #line:orange
SuperAdmin --|> Admin #line:orange
Support --|> User #line:orange

note right of Support
  IMPORTANT — à ne pas oublier :
  Support hérite de User, PAS de Formateur.
  Role.isStaff() exclut explicitement SUPPORT :
  aucun droit pédagogique, aucun droit d'administration,
  seulement messagerie + lecture seule des statistiques.
end note

note right of Admin
  Cet héritage UML (Admin --|> Formateur) est une facilité
  de modélisation du diagramme, PAS une hiérarchie de classes
  Java : le rôle réel utilise RoleHierarchyImpl.fromHierarchy
  ("ROLE_SUPER_ADMIN > ROLE_ADMIN"), une hiérarchie plate
  d'autorisations Spring Security, pas un héritage d'objet.
end note


' =========================================================
' SYSTÈME
' =========================================================

rectangle "Système IAT Academy" {

    ' -----------------------------------------------------
    ' ACCÈS ET COMPTE
    ' -----------------------------------------------------

    usecase "S'inscrire" as UC_Register #line:blue

    usecase "S'authentifier\n(2FA)" as UC_Login #line:blue

    usecase "Accéder à son\nespace personnel" as UC_AccessSpace #line:green

    usecase "Gérer son profil" as UC_Profile #line:green

    usecase "Contacter\nl'académie" as UC_Contact #line:blue

    usecase "Vérifier un\ncertificat" as UC_VerifyCertificate #line:blue


    ' -----------------------------------------------------
    ' COURS ET ÉVALUATIONS
    ' -----------------------------------------------------

    usecase "Consulter les\ncours et modules" as UC_ViewLesson

    usecase "Passer une\névaluation" as UC_TakeQuiz

    usecase "Consulter ses\nrésultats" as UC_ViewResults

    usecase "Concevoir un\nquiz" as UC_ManageQuiz #line:purple

    usecase "Générer des\nquestions par IA" as UC_AiGenerate

    usecase "Évaluer et\nnoter les copies" as UC_Grade #line:purple


    ' -----------------------------------------------------
    ' STAGE ET CERTIFICATION
    ' -----------------------------------------------------

    usecase "Soumettre son\ndossier de stage" as UC_StageDossier

    usecase "Valider une unité\nde formation (UF)" as UC_ValidateUf #line:red

    usecase "Consulter son\ncertificat" as UC_Certificate

    usecase "Inviter le tuteur\nà signer" as UC_InviteSignoff #line:red

    usecase "Partager une réussite\n(badge, diplôme)" as UC_ShareAchievement


    ' -----------------------------------------------------
    ' ADMINISTRATION ET SERVICES
    ' -----------------------------------------------------

    usecase "Échanger par\nmessagerie interne" as UC_Message #line:green

    usecase "Gérer les utilisateurs\net droits" as UC_ManageUsers #line:red

    usecase "Gérer les cohortes\net classes" as UC_ManageGroups #line:red

    usecase "Consulter les\njournaux d'audit" as UC_AuditLog #line:red

    usecase "Configurer les\nparamètres généraux" as UC_AppSettings #line:red

    usecase "Consulter la\nbourse à l'emploi" as UC_JobsView #line:purple

    usecase "Assister les apprenants\n(lecture seule)" as UC_SupportAssist #line:green


    ' =====================================================
    ' ORGANISATION INTERNE DES USE CASES
    ' =====================================================

    ' ----- Colonne 1 -----

    UC_Register -[hidden]down-> UC_Login
    UC_Login -[hidden]down-> UC_Contact
    UC_Contact -[hidden]down-> UC_VerifyCertificate


    ' ----- Colonne 2 -----

    UC_AccessSpace -[hidden]down-> UC_Profile
    UC_Profile -[hidden]down-> UC_Message
    UC_Message -[hidden]down-> UC_JobsView
    UC_JobsView -[hidden]down-> UC_ShareAchievement
    UC_ShareAchievement -[hidden]down-> UC_SupportAssist


    ' ----- Colonne 3 -----

    UC_ViewLesson -[hidden]down-> UC_TakeQuiz
    UC_TakeQuiz -[hidden]down-> UC_ViewResults


    ' ----- Colonne 4 -----

    UC_ManageQuiz -[hidden]down-> UC_AiGenerate
    UC_AiGenerate -[hidden]down-> UC_Grade


    ' ----- Colonne 5 -----

    UC_StageDossier -[hidden]down-> UC_ValidateUf
    UC_ValidateUf -[hidden]down-> UC_InviteSignoff
    UC_InviteSignoff -[hidden]down-> UC_Certificate


    ' ----- Administration -----

    UC_ManageUsers -[hidden]down-> UC_ManageGroups
    UC_ManageGroups -[hidden]down-> UC_AuditLog
    UC_AuditLog -[hidden]down-> UC_AppSettings


    ' ----- Espacement horizontal -----

    UC_Register -[hidden]right-> UC_AccessSpace
    UC_AccessSpace -[hidden]right-> UC_ViewLesson
    UC_ViewLesson -[hidden]right-> UC_ManageQuiz
    UC_ManageQuiz -[hidden]right-> UC_StageDossier
    UC_StageDossier -[hidden]right-> UC_ManageUsers

}


' =========================================================
' RELATIONS AVEC LES ACTEURS (nommées)
' =========================================================


' -------------------------
' VISITEUR
' -------------------------

Visiteur --> UC_Register : crée un compte #line:blue
Visiteur --> UC_Login : se connecte #line:blue
Visiteur --> UC_Contact : envoie un message #line:blue
Visiteur --> UC_VerifyCertificate : contrôle l'authenticité #line:blue


' -------------------------
' UTILISATEUR CONNECTÉ
' -------------------------

User --> UC_AccessSpace : ouvre son tableau de bord #line:green
User --> UC_Profile : met à jour ses informations #line:green
User --> UC_Message : discute avec un contact #line:green


' -------------------------
' ÉTUDIANT
' -------------------------

Etudiant --> UC_ViewLesson : progresse dans un module
Etudiant --> UC_TakeQuiz : répond à une évaluation
Etudiant --> UC_ViewResults : consulte son score
Etudiant --> UC_StageDossier : dépose ses documents
Etudiant --> UC_Certificate : télécharge sa preuve
Etudiant --> UC_ShareAchievement : publie sur LinkedIn
Etudiant --> UC_JobsView : postule (si diplômé)


' -------------------------
' FORMATEUR
' -------------------------

Formateur --> UC_ManageQuiz : construit l'évaluation #line:purple
Formateur --> UC_Grade : corrige une copie ouverte #line:purple


' -------------------------
' ADMIN
' -------------------------

Admin --> UC_ValidateUf : tranche humainement (UF 5 / UF 11) #line:red
Admin --> UC_InviteSignoff : mandate le tuteur externe #line:red
Admin --> UC_ManageUsers : attribue un rôle #line:red
Admin --> UC_ManageGroups : compose une cohorte #line:red
Admin --> UC_AuditLog : investigue une action passée #line:red


' -------------------------
' SUPER ADMIN
' -------------------------

SuperAdmin --> UC_AppSettings : configure la plateforme #line:red


' -------------------------
' SUPPORT
' -------------------------

Support --> UC_Message : répond à un apprenant #line:green
Support --> UC_SupportAssist : consulte (jamais ne modifie) #line:green


note bottom of UC_InviteSignoff
  Le tuteur de stage signe SANS compte utilisateur : il accède
  via un token à usage unique (StageSignoffInvite) — route
  publique /tutor-signoff/{token}, hors authentification.
  Ce n'est donc pas un acteur du système au sens UML.
end note


' =========================================================
' RELATIONS ENTRE CAS (nommées, stéréotypées)
' =========================================================

UC_AccessSpace .> UC_Login : <<include>>

UC_AiGenerate .> UC_ManageQuiz : <<extend>>\n(même validation qu'une question manuelle)

UC_InviteSignoff .> UC_ValidateUf : <<extend>>\n(la signature externe précède la validation UF)


' =========================================================
' POSITIONNEMENT DES ACTEURS
' =========================================================

' Acteurs de gauche

Visiteur -[hidden]right-> UC_Register

User -[hidden]right-> UC_AccessSpace

Etudiant -[hidden]right-> UC_ViewLesson


' Acteurs de droite

UC_ManageQuiz -[hidden]right-> Formateur

UC_ValidateUf -[hidden]right-> Admin

UC_AppSettings -[hidden]right-> SuperAdmin

UC_SupportAssist -[hidden]right-> Support


' Héritage vertical

User -[hidden]down-> Etudiant

Formateur -[hidden]down-> Admin

Admin -[hidden]down-> SuperAdmin

SuperAdmin -[hidden]down-> Support

@enduml
